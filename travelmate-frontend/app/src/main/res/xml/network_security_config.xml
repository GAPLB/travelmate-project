<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- Permitir tráfico HTTP para desarrollo local (emulador y dispositivo en la misma red) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>  <!-- Emulador Android -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>  <!-- Red local (ajustar según tu red) -->
    </domain-config>
</network-security-config>