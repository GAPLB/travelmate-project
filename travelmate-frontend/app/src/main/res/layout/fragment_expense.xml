<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <!-- Título de la sección -->
    <TextView
        android:id="@+id/tvFormExpenseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar Gasto o Actividad"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Selector de Categoría dinámico (Spinner) -->
    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@android:drawable/btn_dropdown"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvFormExpenseTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Concepto (Su texto de ayuda o hint cambiará automáticamente según la categoría seleccionada) -->
    <EditText
        android:id="@+id/etExpenseConcept"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Concepto del gasto o actividad"
        android:inputType="text"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Monto del Gasto -->
    <EditText
        android:id="@+id/etExpenseAmount"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Monto (Ej: 150000.00)"
        android:inputType="numberDecimal"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/etExpenseConcept"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Fecha del Gasto o Actividad -->
    <EditText
        android:id="@+id/etExpenseDate"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Fecha (YYYY-MM-DD)"
        android:inputType="date"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/etExpenseAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Botón para Guardar -->
    <Button
        android:id="@+id/btnSaveExpense"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Guardar Gasto / Actividad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>