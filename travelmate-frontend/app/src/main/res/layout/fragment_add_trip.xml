<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/tvFormTripTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar Nuevo Viaje"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Título del Viaje -->
    <EditText
        android:id="@+id/etTripTitle"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Título del viaje (Ej: Vacaciones Cartagena)"
        android:inputType="text"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvFormTripTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Descripción -->
    <EditText
        android:id="@+id/etTripDescription"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:hint="Descripción o detalles del viaje..."
        android:gravity="top"
        android:inputType="textMultiLine"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/etTripTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Fecha de Inicio -->
    <EditText
        android:id="@+id/etTripStartDate"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Fecha de Inicio (YYYY-MM-DD)"
        android:inputType="date"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/etTripDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Fecha de Fin -->
    <EditText
        android:id="@+id/etTripEndDate"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Fecha de Fin (YYYY-MM-DD)"
        android:inputType="date"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/etTripStartDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Botón Guardar Viaje -->
    <Button
        android:id="@+id/btnSaveTrip"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Guardar Viaje en Servidor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>